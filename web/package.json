{
  "name": "mem-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && vite build --mode mock",
    "build:real": "tsc -b && vite build --mode real && node -e \"const fs=require('fs');const p='dist/mockServiceWorker.js';if(fs.existsSync(p))fs.unlinkSync(p);\"",
    "preview": "vite preview",
    "preview:mock": "vite preview --mode mock --outDir dist-mock",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@mantine/core": "9.8.1",
    "@mantine/form": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@mantine/modals": "9.8.1",
    "@mantine/notifications": "9.8.1",
    "@mantine/spotlight": "9.8.1",
    "@tabler/icons-react": "3.52.0",
    "@tanstack/react-query": "5.108.0",
    "@uiw/react-codemirror": "4.25.12",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.6",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "msw": "3.0.7",
    "postcss": "8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
